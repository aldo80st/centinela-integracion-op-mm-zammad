# Runtime configurations and credentials must never be versioned.
# Copy tracked .env.example templates to local .env files.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Private keys and generated credentials
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
*.secret.local.yaml

# Local build and editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
